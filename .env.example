# Copy this to .env and adjust. .env is gitignored -- never commit real secrets.

# --- Postgres ---
POSTGRES_USER=mirador
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mirador
# Used by the app container to connect. Host is "db" -- that's the compose
# service name, not localhost, because the app talks to Postgres over the
# compose network, not the host's loopback.
DATABASE_URL=postgres://mirador:change-me@db:5432/mirador?sslmode=disable

# --- API auth (Block 4B) ---
# Single static token, sent as a header. Real user accounts are phase 3.
MIRADOR_API_TOKEN=change-me-too

# --- HTTP API (Block 4B) ---
MIRADOR_HTTP_ADDR=:8080
